{
  "name": "yohpal-live-ai-content-factory",
  "version": "1.1.0",
  "private": true,
  "description": "YohPal Live AI Content Factory - seed video generation platform",
  "scripts": {
    "dev": "docker compose -f infra/docker-compose.yml up --build",
    "install:all": "npm install",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@prisma/client": "5.22.0",
    "axios": "1.18.1",
    "dotenv": "16.4.7",
    "express-rate-limit": "8.6.0",
    "helmet": "8.1.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.2.0",
    "kafkajs": "2.2.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.3",
    "prisma": "5.22.0",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
